{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": false,
	"arrowParens": "avoid",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": ["**/pocketbase-types.ts"],
	"sortTailwindcss": {
		"functions": ["clsx", "cva", "tv"],
		"preserveWhitespace": true
	}
}
